# Groq (free at console.groq.com)
GROQ_API_KEY=

# API secret — any random string, used to lock /api/chat to you only
JARVIS_API_SECRET=
NEXT_PUBLIC_JARVIS_SECRET=

# Supabase (free at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. The app reads and writes every table with this key (RLS is on, no policies). Never prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Only for scripts/verify-rls.mjs and backups (session pooler, port 5432). Written by scripts/setup-backups.sh.
SUPABASE_DB_URL=

# Google Calendar (free — Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/calendar/callback
GOOGLE_REFRESH_TOKEN=

# Freshdesk
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# Redash
REDASH_URL=
REDASH_API_KEY=

# Coralogix
CORALOGIX_URL=
CORALOGIX_API_KEY=
